[Unit]
Description=GPT02 Issue159 DEV single attestor record RPC after authenticated three-signer verification (NO DISPATCH)
After=gpt02-issue159-verifier.service gpt02-issue159-approval-reader.service
Requires=gpt02-issue159-verifier.service gpt02-issue159-approval-reader.service
ConditionPathExists=/opt/ai-coding-standalone-dev/gpt02_issue159_attestor_record_once.py
ConditionPathExists=/opt/ai-coding-standalone-dev/gpt02_issue159_approved_claims.json
ConditionPathExists=/opt/ai-coding-standalone-dev/gpt02_issue159_hub_core_link_claims.json
ConditionPathExists=/run/gpt02-issue159-verifier/verify.sock
ConditionPathExists=/run/gpt02-issue159-sign-once-approval/approval-signature.json
ConditionPathExists=/run/gpt02-issue159-sign-once-hub/hub-signature.json
ConditionPathExists=/run/gpt02-issue159-sign-once-core/core-signature.json
ConditionPathExists=/etc/credstore.encrypted/gpt02-issue159-attestor-dsn

[Service]
Type=oneshot
Environment=APP_ENV=development
Environment=GPT02_ATTESTOR_RECORD_ONCE=explicit-approved
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredentialEncrypted=attestor-dsn:/etc/credstore.encrypted/gpt02-issue159-attestor-dsn
WorkingDirectory=/opt/ai-coding-standalone-dev
ExecStart=/usr/bin/python3 -B /opt/ai-coding-standalone-dev/gpt02_issue159_attestor_record_once.py
TimeoutStartSec=15s
Restart=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/opt/ai-coding-standalone-dev/gpt02_issue159_attestor_record_once.py /opt/ai-coding-standalone-dev/gpt02_issue159_attestor_preflight.py /opt/ai-coding-standalone-dev/gpt02_issue159_approved_claims.json /opt/ai-coding-standalone-dev/gpt02_issue159_hub_core_link_claims.json
BindReadOnlyPaths=/run/gpt02-issue159-verifier
StandardOutput=journal
StandardError=journal

# Deliberately static. Never start without a fresh bound Super Admin approval.
