[Unit]
Description=GPT02-1782 CST-DEV independent close-only Owner Ledger recovery (candidate)
Documentation=https://github.com/Travelintrips/Core-AI-Foundation/issues/1850
After=systemd-journald.service
# No Wants/Requires nginx.service: do not start/restart unrelated services.

[Service]
Type=oneshot
User=root
Group=root
Environment=GPT02_CLOSE_ONLY_RECOVERY_ENABLED=true
ExecStart=/usr/bin/python3 /usr/local/sbin/gpt02_1782_close_only_fallback.py --close-only
TimeoutStartSec=75s
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/etc/nginx
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
TasksMax=12
LimitNOFILE=128
StandardOutput=journal
StandardError=journal

# INTENTIONALLY NO [Install] — requires separate Owner-approved installation
# and independent systemd timer arming. This service NEVER resumes the watcher.
