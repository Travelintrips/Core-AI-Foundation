[Unit]
Description=GPT02 DEV independent issuer evidence reader (read-only, Unix socket only)
Documentation=https://github.com/Travelintrips/Core-AI-Foundation/pull/1702
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3
ConditionPathExists=/etc/credstore.encrypted/gpt02-issue159-issuer-reader-dsn
ConditionPathExists=/etc/gpt02-dev/supabase-root-ca-2021.crt

[Service]
Type=simple
DynamicUser=yes
Group=gpt02-issue159-signers
WorkingDirectory=/opt/gpt02-reader-runtime
Environment=NODE_ENV=development
Environment=APP_ENV=development
Environment=PATH=/usr/bin:/bin
Environment=GPT02_ISSUER_READER_SOCKET=/run/gpt02-issuer-reader/reader.sock
LoadCredentialEncrypted=issuer-reader-dsn:/etc/credstore.encrypted/gpt02-issue159-issuer-reader-dsn
LoadCredential=supabase-root-ca-2021.crt:/etc/gpt02-dev/supabase-root-ca-2021.crt
ExecStart=/usr/bin/env node /opt/gpt02-reader-runtime/scripts/dev/gpt02-issuer-reader-runtime.mjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s
RuntimeDirectory=gpt02-issuer-reader
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
LimitNOFILE=256
MemoryMax=256M
TasksMax=32
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/opt/gpt02-reader-runtime
ReadWritePaths=/run/gpt02-issuer-reader /run/private/gpt02-issuer-reader
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
