[Unit]
Description=GPT02 DEV read-only Super Admin approval intent reader
After=local-fs.target
Before=gpt02-issue159-signer@approval.service gpt02-issue159-signer@hub.service gpt02-issue159-signer@core.service gpt02-issue159-signer@issuer.service
StartLimitIntervalSec=60s
StartLimitBurst=3
ConditionPathExists=/opt/ai-coding-standalone-dev/tasks.db

[Service]
Type=simple
User=root
Group=gpt02-issue159-signers
Environment=GPT02_ISSUE159_APPROVAL_READER_ENV=DEV
WorkingDirectory=/opt/ai-coding-standalone-dev
ExecStart=/usr/bin/python3 /opt/ai-coding-standalone-dev/gpt02_issue159_approval_reader_runtime.py
RuntimeDirectory=gpt02-approval-reader
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
LimitNOFILE=128
MemoryMax=128M
TasksMax=16
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/opt/ai-coding-standalone-dev/tasks.db
ReadOnlyPaths=/opt/ai-coding-standalone-dev/gpt02_issue159_approval_intent_reader.py
ReadOnlyPaths=/opt/ai-coding-standalone-dev/gpt02_issue159_approval_store_readiness.py
ReadWritePaths=/run/gpt02-approval-reader
Restart=on-failure
RestartSec=3s
TimeoutStartSec=15s
TimeoutStopSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
