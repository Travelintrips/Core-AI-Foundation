[Unit]
Description=GPT02 DEV persisted Super Admin approval reader (read-only, Unix socket only)
After=local-fs.target
ConditionPathExists=/opt/ai-coding-standalone-dev/tasks.db
ConditionPathExists=/opt/ai-coding-standalone-dev/gpt02_issue159_approval_intent_reader.py
ConditionPathExists=/opt/ai-coding-standalone-dev/gpt02_issue159_approval_reader_runtime.py

[Service]
Type=simple
User=root
Group=gpt02-issue159-signers
WorkingDirectory=/opt/ai-coding-standalone-dev
Environment=PYTHONUNBUFFERED=1
Environment=GPT02_APPROVAL_READER_SOCKET=/run/gpt02-approval-reader/approval.sock
ExecStart=/usr/bin/python3 -u /opt/ai-coding-standalone-dev/gpt02_issue159_approval_reader_runtime.py
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15s
TimeoutStopSec=10s
RuntimeDirectory=gpt02-approval-reader
RuntimeDirectoryMode=0750
UMask=0077
LimitNOFILE=128
MemoryMax=128M
TasksMax=16
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/ai-coding-standalone-dev/tasks.db /opt/ai-coding-standalone-dev/gpt02_issue159_approval_intent_reader.py /opt/ai-coding-standalone-dev/gpt02_issue159_approval_reader_runtime.py
ReadWritePaths=/run/gpt02-approval-reader
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

