[Unit]
Description=Load externally provisioned GPT02 CST-DEV Owner ledger reader credential
After=systemd-tmpfiles-setup.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
Environment=APP_ENV=development
Environment=NODE_ENV=development
# The encrypted blob must be authenticated for the credential name reader.json.
LoadCredentialEncrypted=reader.json:/etc/credstore.encrypted/gpt02-owner-ledger-reader.json
ExecStart=/usr/bin/python3 /usr/local/libexec/cst-dev/gpt02_owner_reader_credential_loader.py
RuntimeDirectory=credentials/gpt02-owner-ledger-reader
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
TimeoutStartSec=15s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/usr/local/libexec/cst-dev
ReadWritePaths=/run/credentials/gpt02-owner-ledger-reader
LimitNOFILE=64
MemoryMax=64M
TasksMax=8
StandardOutput=journal
StandardError=journal

# Intentionally no [Install] section: no boot-time or default activation.
# The reviewed DEV release caller starts this unit only after explicit opt-in.
