[Unit]
Description=GPT02 Issue159 DEV signer custody boundary (%i)
After=local-fs.target gpt02-issue159-reader.service
ConditionPathExists=/run/gpt02-reader/reader.sock
ConditionPathExists=/etc/credstore.encrypted/gpt02-issue159-%i-private-key.pkcs8
ConditionPathExists=/etc/gpt02-dev/trust-fingerprints.json

[Service]
Type=simple
DynamicUser=yes
Environment=GPT02_ISSUE159_SIGNER_ROLE=%i
Environment=GPT02_ISSUE159_SIGNING_ENABLED=false
LoadCredentialEncrypted=private-key.pkcs8:/etc/credstore.encrypted/gpt02-issue159-%i-private-key.pkcs8
LoadCredential=manifest.json:/etc/gpt02-dev/trust-fingerprints.json
ExecStart=/usr/bin/python3 /opt/ai-coding-standalone-dev/gpt02_issue159_signer_runtime.py
RuntimeDirectory=gpt02-issue159-signer-%i
RuntimeDirectoryMode=0700
SupplementaryGroups=gpt02-issue159-signers
BindReadOnlyPaths=/run/gpt02-reader
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
