[Unit]
Description=Safely retire superseded, verified CST Docker image tags
Documentation=https://github.com/Travelintrips/Core-AI-Foundation
Requires=docker.service
After=docker.service
ConditionPathExists=/var/lib/cst-docker-image-retention

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cst-docker-image-retention
ExecStart=/usr/bin/python3 /usr/local/libexec/cst-docker-active-only.py --apply
ExecStart=/usr/bin/python3 /usr/local/libexec/cst-docker-image-retention.py sweep --apply --exclude-service core-dev --exclude-service core-prod
ExecStart=/usr/bin/python3 /usr/local/libexec/cst-docker-stale-backups.py --apply
ExecStart=/usr/bin/docker image prune --all --force --filter until=168h
ExecStart=/usr/bin/docker buildx prune --all --force --filter until=168h --max-used-space 4gb --reserved-space 2gb
