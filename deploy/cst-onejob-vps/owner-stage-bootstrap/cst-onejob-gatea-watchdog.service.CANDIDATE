# CST-DEV Gate A watchdog systemd SOURCE CANDIDATE ONLY.
# DO NOT install, enable or start. This unit requires independent authorization,
# dedicated PostgreSQL administrative credentials, verified source and network ACL.
# A source-only runner now exists; no operational unit, credential or network ACL is installed.
# Restart after a process crash is NOT proof of a full VPS power-off relock.
[Unit]
Description=CST-DEV independent Gate A lease relock watchdog (NO-GO candidate)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
# Retry indefinitely after temporary database failure; each retry fails closed.
AssertPathExists=/etc/cst-onejob-dev/gatea-authority/approved-gatea-public.pem
AssertPathExists=/etc/cst-onejob-dev/gatea-authority/signed-gatea-manifest.json
AssertPathExists=/etc/cst-onejob-dev/gatea-authority/gatea-approved-public.env
AssertPathExists=/etc/cst-onejob-dev/gatea-authority/independent-gatea-approval.json
AssertPathExists=/etc/cst-onejob-dev/gatea-watchdog/watchdog-admin-credential
AssertPathExists=/etc/cst-onejob-dev/gatea-watchdog/supabase-root-2021.pem
AssertPathExists=/run/netns/cst-onejob-gatea-watchdog-reviewed
AssertPathExists=/opt/cst-onejob-dev/bootstrap/cst_onejob_preapproval_stage_broker.py
AssertPathExists=/opt/cst-onejob-dev/bootstrap/cst_onejob_stage_watchdog_runner.py

[Service]
Type=simple
# systemd DynamicUser provides a distinct non-login service identity and
# automatically owns the temporary LoadCredential copies. Avoid running a
# root wrapper or copying an administrative secret into a shared UID path.
# Verified with transient systemd synthetic credential, not a real DB key.
DynamicUser=yes
User=cst-onejob-gatea-watchdog
UMask=0077
WorkingDirectory=/opt/cst-onejob-dev/bootstrap
RuntimeDirectory=cst-onejob-gatea-watchdog
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
NetworkNamespacePath=/run/netns/cst-onejob-gatea-watchdog-reviewed
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/cst-onejob-dev/gatea-authority/gatea-approved-public.env
LoadCredential=watchdog-db:/etc/cst-onejob-dev/gatea-watchdog/watchdog-admin-credential
LoadCredential=watchdog-ca:/etc/cst-onejob-dev/gatea-watchdog/supabase-root-2021.pem
# The existing signed-manifest validator is reused; no new trust authority.
# Run the check as the eventual watchdog identity, not root.
ExecStartPre=/usr/bin/python3 -B /opt/cst-onejob-dev/bootstrap/cst_onejob_preapproval_stage_broker.py validate --envelope /etc/cst-onejob-dev/gatea-authority/signed-gatea-manifest.json --public-key /etc/cst-onejob-dev/gatea-authority/approved-gatea-public.pem --pinned-sha256 ${CST_GATEA_APPROVED_PUBKEY_SHA256} --expected-source-sha ${CST_GATEA_PINNED_SOURCE_SHA}
# LoadCredential is owned by systemd's transient service identity, and
# the validator/runner share that identity. If the credential is missing,
# the nonroot ExecStartPre fails before running any database action.
ExecStartPre=/usr/bin/test -r ${CREDENTIALS_DIRECTORY}/watchdog-db
ExecStartPre=/usr/bin/test -r ${CREDENTIALS_DIRECTORY}/watchdog-ca
# The runner exists as source only. It rejects unpinned TLS, unknown DB roles,
# URLs outside CST-DEV, and SQL outside the fixed relock query allowlist.
# No real relock-only credential or grant has been approved/provisioned.
ExecStart=/usr/bin/python3 -B /opt/cst-onejob-dev/bootstrap/cst_onejob_stage_watchdog_runner.py --credential-file ${CREDENTIALS_DIRECTORY}/watchdog-db --ca-file ${CREDENTIALS_DIRECTORY}/watchdog-ca --expected-source-sha ${CST_GATEA_PINNED_SOURCE_SHA}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
TimeoutStopSec=8s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=192M
TasksMax=16

# Future install contract only. Never enabled until an independent approved
# relock runner, credential scope, network ACL and host-reboot test are PASS.
[Install]
WantedBy=multi-user.target