# AI Core worker stack (copy to .env; installer creates/repairs generated secrets)
COMPOSE_PROJECT_NAME=ai-core-workers
TZ=Asia/Jakarta

# Pinned component versions. Upgrade deliberately after review.
TEMPORAL_VERSION=1.32.0
TEMPORAL_ADMINTOOLS_VERSION=1.32.0
TEMPORAL_UI_VERSION=2.54.1
N8N_VERSION=2.40.7
OPENHANDS_VERSION=1.24.0
OPENCLAW_VERSION=2026.9.6

# Loopback-only host ports. Put an authenticated reverse proxy in front if remote UI access is needed.
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
N8N_PORT=5678
OPENHANDS_PORT=8000
OPENCLAW_PORT=18789

# Generated automatically by scripts/install-ai-workers.sh when empty.
TEMPORAL_POSTGRES_PASSWORD=
N8N_POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
OPENHANDS_LOCAL_BACKEND_API_KEY=
OPENCLAW_GATEWAY_TOKEN=

# Persistent workspace visible to OpenHands. The installer creates this directory.
OPENHANDS_PROJECTS_PATH=/opt/ai-workers/projects
# Agent Canvas runs as the openhands user (UID/GID 1000 in the official image).
# Used only when the installer creates a new empty workspace directory.
OPENHANDS_PROJECTS_UID=1000
OPENHANDS_PROJECTS_GID=1000

# Optional OpenHands model profile.
# Use an OpenAI-compatible endpoint when routing through a gateway.
# Do NOT put AI Core ADMIN_API_KEY here.
OPENHANDS_LLM_MODEL=
OPENHANDS_LLM_BASE_URL=
OPENHANDS_LLM_API_KEY=

# OpenClaw unattended onboarding currently uses an OpenAI API key.
# Supply this through a protected host env/secrets file; never commit a real key.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional public URLs when placed behind HTTPS reverse proxy.
N8N_HOST=
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=
TEMPORAL_CORS_ORIGINS=http://127.0.0.1:8233

# AI Core control-plane URL for integrations. Agents are intentionally NOT given
# ADMIN_API_KEY. Add a scoped service token only after AI Core exposes one.
AI_CORE_BASE_URL=https://aicore.cstlogistic.co.id/api
AI_CORE_SCOPED_AGENT_TOKEN=
