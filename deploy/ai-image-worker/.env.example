COMPOSE_PROJECT_NAME=ai-core-image-worker
TZ=Asia/Jakarta

# Pinned application/runtime versions.
COMFYUI_VERSION=v0.38.0
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Loopback only. Put an authenticated reverse proxy or AI Core service in front.
COMFYUI_PORT=8188

# Persistent paths. Keep model weights outside the container image.
COMFYUI_MODELS_PATH=/opt/ai-image-worker/models
COMFYUI_INPUT_PATH=/opt/ai-image-worker/input
COMFYUI_OUTPUT_PATH=/opt/ai-image-worker/output
COMFYUI_USER_PATH=/opt/ai-image-worker/user
COMFYUI_CUSTOM_NODES_PATH=/opt/ai-image-worker/custom_nodes

# Optional Hugging Face token for gated/licensed model downloads.
HF_TOKEN=

# Auto power-off when the VM has no queued/running generation jobs.
AI_IMAGE_IDLE_SHUTDOWN_ENABLED=true
AI_IMAGE_IDLE_MINUTES=10
