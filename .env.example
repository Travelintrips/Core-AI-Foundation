# Creative AI Studio — Environment Variables Template
# Copy this file to .env for local development.
# NEVER commit actual secret values to git.
# Use Replit Secrets for sensitive values in the Replit environment.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── AI Job Engine ────────────────────────────────────────────────────────────
# Both must be "true" in production for the job queue to process work.
AI_DISPATCHER_ENABLED=true
AI_SCHEDULER_ENABLED=true
AI_SCHEDULER_POLL_INTERVAL_MS=5000
AI_SCHEDULER_TIMEZONE=Asia/Jakarta

# ── Application ──────────────────────────────────────────────────────────────
PUBLIC_APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://your-admin-domain.com

# ── Authentication (set as Replit Secrets — never plaintext) ─────────────────
SESSION_SECRET=<use Replit Secrets>
ADMIN_API_KEY=<use Replit Secrets>

# ── Database (set as Replit Secrets — never plaintext) ───────────────────────
SUPABASE_DEV_DATABASE_URL=<use Replit Secrets>
SUPABASE_PROD_DATABASE_URL=<use Replit Secrets>
SUPABASE_URL_DEV=https://your-project.supabase.co
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY_DEV=<use Replit Secrets>
SUPABASE_ANON_KEY=<use Replit Secrets>
SUPABASE_SERVICE_ROLE_KEY_DEV=<use Replit Secrets>
SUPABASE_SERVICE_ROLE_KEY=<use Replit Secrets>
SUPABASE_STORAGE_BUCKET_DEV=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=https://your-prod-project.storage.supabase.co/storage/v1/s3

# ── AI Providers (set as Replit Secrets — never plaintext) ───────────────────
OPENAI_API_KEY=<use Replit Secrets>
ANTHROPIC_API_KEY=<use Replit Secrets>
GEMINI_API_KEY=<use Replit Secrets>
REPLICATE_API_TOKEN=<use Replit Secrets>
MISTRAL_API_KEY=<use Replit Secrets>
COHERE_API_KEY=<use Replit Secrets>

# ── Email (set SMTP_PASS as Replit Secret) ───────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@your-domain.com
SMTP_FROM=info@your-domain.com
SMTP_PASS=<use Replit Secrets>

# ── WhatsApp (set as Replit Secret) ──────────────────────────────────────────
FONNTE_TOKEN=<use Replit Secrets>

# ── Optional: Design AI ──────────────────────────────────────────────────────
DESIGN_AI_MULTI_AGENT_ENABLED=true

# ── Optional: Internal Admin ─────────────────────────────────────────────────
INITIAL_INTERNAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_INTERNAL_ADMIN_PASSWORD=<use Replit Secrets>
