# =============================================================================
# Creative AI Studio — Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# ALL values listed here must be set via Replit Secrets in production.
# NEVER paste actual credentials into this file or into .replit.
# =============================================================================

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=<set-in-replit-secrets>
ANTHROPIC_API_KEY=<set-in-replit-secrets>
GEMINI_API_KEY=<set-in-replit-secrets>
MISTRAL_API_KEY=<set-in-replit-secrets>
COHERE_API_KEY=<set-in-replit-secrets>
REPLICATE_API_TOKEN=<set-in-replit-secrets>

# ── Database — Development (Supabase) ─────────────────────────────────────────
SUPABASE_DEV_DATABASE_URL=<set-in-replit-secrets>
SUPABASE_DATABASE_URL_DEV=<set-in-replit-secrets>
SUPABASE_ANON_KEY_DEV=<set-in-replit-secrets>
SUPABASE_SERVICE_ROLE_KEY_DEV=<set-in-replit-secrets>

# ── Database — Production (Supabase) ──────────────────────────────────────────
SUPABASE_PROD_DATABASE_URL=<set-in-replit-secrets>
SUPABASE_DATABASE_URL=<set-in-replit-secrets>
SUPABASE_ANON_KEY=<set-in-replit-secrets>
SUPABASE_SERVICE_ROLE_KEY=<set-in-replit-secrets>
VITE_SUPABASE_ANON_KEY=<set-in-replit-secrets>

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# Non-secret SMTP config is in .replit [userenv.shared]
SMTP_PASS=<set-in-replit-secrets>

# ── WhatsApp / Fonnte ─────────────────────────────────────────────────────────
FONNTE_TOKEN=<set-in-replit-secrets>

# ── Admin Authentication ──────────────────────────────────────────────────────
ADMIN_API_KEY=<set-in-replit-secrets>
VITE_ADMIN_API_KEY=<set-in-replit-secrets>

# ── Local Coding GitHub Publisher ─────────────────────────────────────────────
# Fine-grained token scoped only to approved coding repositories.
# Required permissions: Contents read/write, Pull requests read/write, Metadata read.
# Store only in the production secret manager; never expose to VITE/browser variables.
AI_CODING_GITHUB_TOKEN=<set-in-production-secret-manager>
# Public fallback remains searchable when the token is absent.
AI_CODING_GITHUB_PUBLIC_OWNERS=Travelintrips

# ── Local Coding Verification Sandbox ─────────────────────────────────────────
# Fail-closed by default. Enable only where a local Docker runtime is available.
AI_CODING_SANDBOX_ENABLED=false
# Immutable prebuilt image containing Node + pnpm + the approved offline pnpm store.
# Tags such as node:22 are rejected; use a digest-pinned reference only.
AI_CODING_SANDBOX_IMAGE=ghcr.io/your-org/ai-coding-sandbox@sha256:<64-hex-digest>
AI_CODING_SANDBOX_MEMORY=1024m
AI_CODING_SANDBOX_CPUS=1
AI_CODING_SANDBOX_PIDS=256

# ── AI Coding Handoff Lease ───────────────────────────────────────────────────
# Approved AI handoff packages expire quickly and must be re-prepared if stale.
# Bounded to 60..3600 seconds by the server; default is 900 seconds.
AI_CODING_AI_HANDOFF_TTL_SECONDS=900

# ── ZeroLLM Local Coding Provider ─────────────────────────────────────────────
# Python dependency is installed only when ZeroLLM is enabled/required or selected
# as the explicit coding provider. Keep installation disabled on Node-only hosts.
ZEROLLM_INSTALL_ENABLED=false
ZEROLLM_ENABLED=false
ZEROLLM_REQUIRED=false
ZEROLLM_PORT=8765
ZEROLLM_BASE_URL=http://127.0.0.1:8765/v1
ZEROLLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B
# Set true on the deployment where ZeroLLM will actually run. This downloads the
# model during bootstrap; runtime then defaults to offline inference.
ZEROLLM_PRELOAD_MODEL=false
ZEROLLM_RUNTIME_OFFLINE=true
# To route constrained coding explicitly to the local provider:
# AI_CODING_PROVIDER=zerollm
# AI_CODING_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B

# ── Session / Token Secrets ───────────────────────────────────────────────────
SESSION_SECRET=<set-in-replit-secrets>

# ── Internal Admin Bootstrap (development only) ───────────────────────────────
INITIAL_INTERNAL_ADMIN_EMAIL=<set-in-replit-secrets>
INITIAL_INTERNAL_ADMIN_PASSWORD=<set-in-replit-secrets>

# ── Non-secret config (also set in .replit [userenv]) ────────────────────────
# These do NOT need to be in Replit Secrets — they are already in .replit.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_FROM=info@cstlogistic.co.id
# SMTP_USER=info@cstlogistic.co.id
# ALLOWED_ORIGINS=https://aicore.cstlogistic.co.id,...
# DESIGN_AI_MULTI_AGENT_ENABLED=true
# SUPABASE_URL_DEV=https://...supabase.co
# SUPABASE_URL=https://...supabase.co
# PUBLIC_APP_URL=https://aicore.cstlogistic.co.id

# ── CST WA Gateway — AI Coding Notifications ────────────────────────────────
# Server-side only. Used by AI Core coding bridge to send CHECKPOINT/BLOCKER/
# COMPLETED/FAILED updates through CST-WA-GATEWAY.
CST_WA_GATEWAY_URL=https://wa.cstlogistic.co.id
CST_WA_GATEWAY_API_KEY=<set-in-production-secret-manager>
AI_CODING_WA_NOTIFY_TO=<set-in-production-secret-manager>

# Docker project adapter — fail-closed production deployment gate
AI_CODING_DOCKER_DEPLOY_ENABLED=false


# ── Distributed Ollama worker runtime ────────────────────────────────────────
# Disabled by default. Enable only on a host that actually runs Ollama.
OLLAMA_WORKER_RUNTIME_ENABLED=false
OLLAMA_WORKER_NAME=
OLLAMA_WORKER_NODE_ID=
OLLAMA_WORKER_MODEL=qwen2.5-coder:7b
OLLAMA_WORKER_LOCAL_URL=http://127.0.0.1:11434/v1
# Must be a private/loopback URL or explicitly allowed host.
OLLAMA_WORKER_ADVERTISE_URL=
OLLAMA_WORKER_MAX_CONCURRENCY=2
OLLAMA_WORKER_HEARTBEAT_MS=10000
OLLAMA_WORKER_CLUSTER_ID=ollama
OLLAMA_WORKER_REGION=local
OLLAMA_WORKER_ALLOWED_HOSTS=


# WhatsApp -> AI Coding inbound webhook
# Must match CST-WA-GATEWAY INCOMING_WEBHOOK_SECRET.
AI_CODING_WA_INCOMING_SECRET=<set-in-production-secret-manager>
# Comma-separated owner/admin WhatsApp numbers in international digit format.
AI_CODING_WA_ALLOWED_SENDERS=<set-in-production-secret-manager>
