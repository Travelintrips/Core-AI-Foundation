# =============================================================================
# Creative AI Studio — Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# ALL values listed here must be set via Replit Secrets in production.
# NEVER paste actual credentials into this file or into .replit.
# =============================================================================

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=<set-in-replit-secrets>
ANTHROPIC_API_KEY=<set-in-replit-secrets>
GEMINI_API_KEY=<set-in-replit-secrets>
MISTRAL_API_KEY=<set-in-replit-secrets>
COHERE_API_KEY=<set-in-replit-secrets>
REPLICATE_API_TOKEN=<set-in-replit-secrets>

# ── Database — Development (Supabase) ─────────────────────────────────────────
SUPABASE_DEV_DATABASE_URL=<set-in-replit-secrets>
SUPABASE_DATABASE_URL_DEV=<set-in-replit-secrets>
SUPABASE_ANON_KEY_DEV=<set-in-replit-secrets>
SUPABASE_SERVICE_ROLE_KEY_DEV=<set-in-replit-secrets>

# ── Database — Production (Supabase) ──────────────────────────────────────────
SUPABASE_PROD_DATABASE_URL=<set-in-replit-secrets>
SUPABASE_DATABASE_URL=<set-in-replit-secrets>
SUPABASE_ANON_KEY=<set-in-replit-secrets>
SUPABASE_SERVICE_ROLE_KEY=<set-in-replit-secrets>
VITE_SUPABASE_ANON_KEY=<set-in-replit-secrets>

# Optional additional admin read-only connections. Use server-side env references only.
# The primary connection already discovers all application schemas, including sport_center.
# Example: [{"id":"sports","label":"Sport center","databaseUrlEnv":"SPORT_DATABASE_URL"}]
AI_CORE_ADMIN_DATABASES_JSON=[]

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# Non-secret SMTP config is in .replit [userenv.shared]
SMTP_PASS=<set-in-replit-secrets>

# ── WhatsApp / Fonnte ─────────────────────────────────────────────────────────
FONNTE_TOKEN=<set-in-replit-secrets>

# ── Admin Authentication ──────────────────────────────────────────────────────
ADMIN_API_KEY=<set-in-replit-secrets>
VITE_ADMIN_API_KEY=<set-in-replit-secrets>

# ── Local Coding GitHub Publisher ─────────────────────────────────────────────
# Fine-grained token scoped only to approved coding repositories.
# Required permissions: Contents read/write, Pull requests read/write, Metadata read.
# Store only in the production secret manager; never expose to VITE/browser variables.
AI_CODING_GITHUB_TOKEN=<set-in-production-secret-manager>
# Public fallback remains searchable when the token is absent.
AI_CODING_GITHUB_PUBLIC_OWNERS=Travelintrips

# ── Local Coding Verification Sandbox ─────────────────────────────────────────
# Fail-closed by default. Enable only where a local Docker runtime is available.
AI_CODING_SANDBOX_ENABLED=false
# Immutable prebuilt image containing Node + pnpm + the approved offline pnpm store.
# Tags such as node:22 are rejected; use a digest-pinned reference only.
AI_CODING_SANDBOX_IMAGE=ghcr.io/your-org/ai-coding-sandbox@sha256:<64-hex-digest>
AI_CODING_SANDBOX_MEMORY=1024m
AI_CODING_SANDBOX_CPUS=1
AI_CODING_SANDBOX_PIDS=256

# ── AI Coding Handoff Lease ───────────────────────────────────────────────────
# Approved AI handoff packages expire quickly and must be re-prepared if stale.
# Bounded to 60..3600 seconds by the server; default is 900 seconds.
AI_CODING_AI_HANDOFF_TTL_SECONDS=900

# ── ZeroLLM Local Coding Provider ─────────────────────────────────────────────
# Python dependency is installed only when ZeroLLM is enabled/required or selected
# as the explicit coding provider. Keep installation disabled on Node-only hosts.
ZEROLLM_INSTALL_ENABLED=false
ZEROLLM_ENABLED=false
ZEROLLM_REQUIRED=false
ZEROLLM_PORT=8765
ZEROLLM_BASE_URL=http://127.0.0.1:8765/v1
ZEROLLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B
# Set true on the deployment where ZeroLLM will actually run. This downloads the
# model during bootstrap; runtime then defaults to offline inference.
ZEROLLM_PRELOAD_MODEL=false
ZEROLLM_RUNTIME_OFFLINE=true
# To route constrained coding explicitly to the local provider:
# AI_CODING_PROVIDER=zerollm
# AI_CODING_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B

# ── Session / Token Secrets ───────────────────────────────────────────────────
SESSION_SECRET=<set-in-replit-secrets>

# ── Internal Admin Bootstrap (development only) ───────────────────────────────
INITIAL_INTERNAL_ADMIN_EMAIL=<set-in-replit-secrets>
INITIAL_INTERNAL_ADMIN_PASSWORD=<set-in-replit-secrets>

# ── Non-secret config (also set in .replit [userenv]) ────────────────────────
# These do NOT need to be in Replit Secrets — they are already in .replit.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_FROM=info@cstlogistic.co.id
# SMTP_USER=info@cstlogistic.co.id
# ALLOWED_ORIGINS=https://aicore.cstlogistic.co.id,...
# DESIGN_AI_MULTI_AGENT_ENABLED=true
# SUPABASE_URL_DEV=https://...supabase.co
# SUPABASE_URL=https://...supabase.co
# PUBLIC_APP_URL=https://aicore.cstlogistic.co.id

# ── CST WA Gateway — AI Coding Notifications ────────────────────────────────
# Server-side only. Used by AI Core coding bridge to send CHECKPOINT/BLOCKER/
# COMPLETED/FAILED updates through CST-WA-GATEWAY.
CST_WA_GATEWAY_URL=https://wa.cstlogistic.co.id
CST_WA_GATEWAY_API_KEY=<set-in-production-secret-manager>
AI_CODING_WA_NOTIFY_TO=<set-in-production-secret-manager>

# Docker project adapter — fail-closed production deployment gate
AI_CODING_DOCKER_DEPLOY_ENABLED=false


# ── Distributed Ollama worker runtime ────────────────────────────────────────
# Disabled by default. Enable only on a host that actually runs Ollama.
OLLAMA_WORKER_RUNTIME_ENABLED=false
OLLAMA_WORKER_NAME=
OLLAMA_WORKER_NODE_ID=
OLLAMA_WORKER_MODEL=qwen2.5-coder:7b
OLLAMA_WORKER_LOCAL_URL=http://127.0.0.1:11434/v1
# Must be a private/loopback URL or explicitly allowed host.
OLLAMA_WORKER_ADVERTISE_URL=
OLLAMA_WORKER_MAX_CONCURRENCY=2
OLLAMA_WORKER_HEARTBEAT_MS=10000
OLLAMA_WORKER_RECONNECT_MIN_MS=2000
OLLAMA_WORKER_RECONNECT_MAX_MS=30000
OLLAMA_WORKER_HEALTHCHECK_TIMEOUT_MS=2500
OLLAMA_WORKER_CLUSTER_ID=ollama
OLLAMA_WORKER_REGION=local
OLLAMA_WORKER_ALLOWED_HOSTS=
# Server-side secret sent as x-api-key when the worker endpoint is protected by a reverse proxy.
OLLAMA_WORKER_API_KEY=<set-in-production-secret-manager>

# Remote pull worker concurrency. Start at 2 on a single NVIDIA L4; raise to 4 only after load testing.
OLLAMA_REMOTE_POLL_MS=1000
OLLAMA_REMOTE_INVOCATION_TIMEOUT_MS=45000
# Reuses OLLAMA_WORKER_MAX_CONCURRENCY above; remote worker clamps to 1..4.

# GCP GPU lifecycle. On the GPU VM, auto-stop after 5 minutes with no active/claimable jobs.
GCP_GPU_AUTO_STOP_ENABLED=false
GCP_GPU_IDLE_STOP_MS=300000

# On the AI Core API host, allow a queued Ollama request to wake the stopped VM.
GCP_OLLAMA_AUTOSTART_ENABLED=false
GCP_OLLAMA_VM_PROJECT=ollama-510011
GCP_OLLAMA_VM_ZONE=asia-northeast1-c
GCP_OLLAMA_VM_INSTANCE=instance-20260928-124118
# Optional dedicated service account JSON. If omitted, bootstrap credentials are reused.
# The credential needs only permission to start this VM; the VM service account needs permission to stop itself.
GCP_OLLAMA_COMPUTE_SA_JSON=<set-in-production-secret-manager>

# GCP coding-worker lifecycle. When a bridge job is queued, start one worker only if none is already starting/running.
GCP_CODING_WORKER_AUTOSTART_ENABLED=false
GCP_CODING_WORKER_PROJECT=aicore-505614
GCP_CODING_WORKER_ZONE=asia-southeast2-a
GCP_CODING_WORKER_INSTANCES=ai-coding-worker-08,ai-coding-worker-11,ai-coding-worker-01,ai-coding-worker-02,ai-coding-worker-03
# Optional dedicated credential; falls back to GCP_SECRET_MANAGER_BOOTSTRAP_JSON.
GCP_CODING_WORKER_COMPUTE_SA_JSON=<set-in-production-secret-manager>

# AI Core Chat infrastructure control plane (server-side secrets only).
HOSTINGER_API_TOKEN=<set-in-production-secret-manager>
HOSTINGER_VPS_ID=<hostinger-vps-id>
HOSTINGER_DOCKER_PROJECT=<docker-compose-project-name>
# Optional defaults for Hostinger hosting/domain discovery and DNS operations.
HOSTINGER_HOSTING_USERNAME=<hostinger-hosting-username>
HOSTINGER_HOSTING_DOMAIN=<hostinger-primary-domain>
# Optional API base override; normally leave blank to use Hostinger's official API.
HOSTINGER_API_BASE=


# WhatsApp -> AI Coding inbound webhook
# Must match CST-WA-GATEWAY INCOMING_WEBHOOK_SECRET.
AI_CODING_WA_INCOMING_SECRET=<set-in-production-secret-manager>
# Comma-separated owner/admin WhatsApp numbers in international digit format.
AI_CODING_WA_ALLOWED_SENDERS=<set-in-production-secret-manager>


# ── Local Media Runtime (ComfyUI + FFmpeg) ────────────────────────────────────
# Local-only renderer bridge for free image/video generation on a workstation.
# ComfyUI must bind to loopback (127.0.0.1/localhost); remote URLs are rejected.
LOCAL_MEDIA_RUNTIME_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
FFMPEG_PATH=ffmpeg


# ── Blender Local 3D Worker ───────────────────────────────────────────────────
# Opt-in local workstation runtime. Keep disabled on hosts without Blender.
BLENDER_WORKER_RUNTIME_ENABLED=false
BLENDER_EXECUTABLE_PATH=blender
BLENDER_OUTPUT_DIR=
BLENDER_WORKER_SCRIPT=


# Dedicated credential for the ChatGPT -> AI Core direct-command connector.
# Generate a long random secret and store the production value in the deployment
# secret manager. This credential is scoped to POST /api/ai/core-chat/messages
# and GET /api/ai/core-chat/tasks/:id/progress only.
AI_CORE_CHAT_CONNECTOR_KEY=
AI_CORE_PUBLIC_BASE_URL=https://aicore.cstlogistic.co.id

# AI Core Chat uses OpenAI as the primary cloud provider by default.
# Leave AI_CORE_CHAT_PRIMARY_MODEL blank to select the best active OpenAI model
# from the registered model catalog. Other cloud providers remain fallbacks.
AI_CORE_CHAT_PRIMARY_PROVIDER=openai
AI_CORE_CHAT_PRIMARY_MODEL=

# Optional: Google Cloud Billing BigQuery export for Workspace GCP Usage & Cost
# The compute service account must have BigQuery read/job permissions on this billing export project.
GCP_BILLING_EXPORT_PROJECT=
GCP_BILLING_EXPORT_DATASET=
GCP_BILLING_EXPORT_TABLE=
GCP_BILLING_CURRENCY=IDR

# AI Provider Billing monitor (server-side only; store real keys in GCP Secret Manager).
# Secure Secret Admin uses GCP_SECRET_MANAGER_BOOTSTRAP_JSON server-side only.
# The service account must retain secretAccessor and also have permission to add
# new versions to the existing aicore-app-secrets secret. Secret values are never
# returned by the admin status API or written to application logs.
# OpenAI organization Usage/Costs API requires an Admin API key.
OPENAI_ADMIN_KEY=
OPENAI_MONTHLY_BUDGET_USD=
# Anthropic Usage & Cost Admin API requires an Admin API key.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_MONTHLY_BUDGET_USD=
# Gemini cost is read from the same GCP Cloud Billing BigQuery export above.
GEMINI_BILLING_PROJECT_ID=
# Uses GCP_BILLING_CURRENCY units.
GEMINI_MONTHLY_BUDGET=
# Alert at this percent of the configured monthly provider budget.
AI_PROVIDER_BILLING_ALERT_PERCENT=80
AI_PROVIDER_BILLING_MONITOR_ENABLED=true
AI_PROVIDER_BILLING_MONITOR_INTERVAL_MS=900000
