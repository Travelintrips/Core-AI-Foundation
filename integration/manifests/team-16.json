{
  "team": "16",
  "domain": "presentation-document",
  "branch": "feature/16-presentation-document",
  "version": "1.1.0",
  "description": "Presentation and Document Creative Services — PDF generation for proposal, product catalog, annual report, whitepaper, case study, and ebook service types.",
  "ownership": {
    "backend": [
      "artifacts/api-server/src/domains/presentation-document/"
    ],
    "integration": [
      "integration/openapi/team-16.yaml",
      "integration/manifests/team-16.json"
    ]
  },

  "routesToMount": [],

  "pagesToRegister": [],

  "schemaExportsRequested": [
    {
      "targetFile": "artifacts/api-server/src/services/creativeProjectDocumentType.ts",
      "action": "extend_union",
      "field": "CreativeDocumentType",
      "addValues": [
        "proposal",
        "product_catalog",
        "annual_report",
        "whitepaper",
        "case_study",
        "ebook"
      ],
      "note": "Add 6 new document type literals to the shared CreativeDocumentType union."
    },
    {
      "targetFile": "artifacts/api-server/src/services/creativeProjectDocumentType.ts",
      "action": "extend_record",
      "field": "SERVICE_CODE_TO_DOCUMENT_TYPE",
      "addEntries": {
        "proposal":       "proposal",
        "product-catalog":"product_catalog",
        "annual-report":  "annual_report",
        "whitepaper":     "whitepaper",
        "case-study":     "case_study",
        "ebook":          "ebook"
      },
      "note": "Map the 6 new service codes to their document types in the shared routing record."
    }
  ],

  "dependencyRequests": [
    {
      "targetFile": "artifacts/api-server/src/services/creativeDocumentRegistry.ts",
      "action": "add_import_and_call",
      "import": "import { initPresentationDocumentDomain } from '../domains/presentation-document/index.js';",
      "callSite": "inside initDocumentRegistry() — append after the last existing registerDocument() call",
      "callStatement": "initPresentationDocumentDomain();",
      "note": "Registers all 6 Team 16 document definitions into the generic Document Engine at startup. Safe to call multiple times (idempotent)."
    }
  ],

  "integrationNotes": [
    "All 6 document types use the existing generic Document Engine (creativeDocumentWorkerService). No new engine or parallel runner is introduced.",
    "briefJson must be fetched from ai_service_requests via project.serviceRequestId inside each mapper's generateContent — it is NOT a column on creative_projects.",
    "The domain self-registers via initPresentationDocumentDomain() which calls registerDocument() for each type. This function MUST be called from initDocumentRegistry() to activate routing.",
    "schemaExportsRequested above must be applied to creativeProjectDocumentType.ts (locked file) by the integration team before merging this branch.",
    "seedCatalog.ts already includes the 6 new service entries (proposal, product-catalog, annual-report, whitepaper, case-study, ebook) — no further seed changes needed.",
    "No new DB tables, no migrations, no changes to lib/db/src/schema/."
  ],

  "serviceTypes": [
    {
      "serviceType": "proposal",
      "serviceCode": "proposal",
      "status": "implemented",
      "renderEngine": "document",
      "deliveryFormat": "pdf",
      "minimumPageCount": 4,
      "maxInlineImages": 1,
      "antiFabricationGuard": "no_pricing_figures_or_legal_terms",
