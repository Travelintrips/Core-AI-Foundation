{
  "id": "/ai-core-chat",
  "name": "AI Core Chat",
  "short_name": "AI Core",
  "description": "AI Core Chat command center for questions, repository work, database operations, and infrastructure control.",
  "start_url": "/ai-core-chat?standalone=1",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#060B18",
