{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --tsconfig tsconfig.json src/seed.ts",
    "seed:internal-admin": "tsx --tsconfig tsconfig.json src/seedInternalAdmin.ts",
    "reset:admin-password": "tsx --tsconfig tsconfig.json src/resetAdminPassword.ts",
    "test": "vitest run",
    "creative:audit-false-completions": "tsx --tsconfig tsconfig.json src/scripts/auditFalseCompletions.ts",
    "migrate:v42e": "tsx --tsconfig tsconfig.json src/migrate-v42e.ts",
    "migrate:v43": "tsx --tsconfig tsconfig.json src/migrate-v43.ts",
    "migrate:v43-gallery": "tsx --tsconfig tsconfig.json src/migrate-v43-portfolio-gallery.ts",
    "seed:templates": "tsx --tsconfig tsconfig.json src/seedTemplates.ts",
    "migrate:v44": "tsx --tsconfig tsconfig.json src/migrate-v44.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@supabase/supabase-js": "^2.110.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "3.10.1",
    "nodemailer": "^9.0.3",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pptxgenjs": "4.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.4",
    "vitest": "^4.1.10"
  }
}
