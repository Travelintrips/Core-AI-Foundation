{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/hostinger-pnpm-bootstrap.cjs",
    "build": "node ./scripts/hostinger-build.cjs",
    "start": "node ./scripts/hostinger-start.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "build:generated": "pnpm --filter @workspace/api-spec run codegen",
    "build:libs": "pnpm run typecheck:libs",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:workspace": "pnpm run build:generated && pnpm run build:libs && pnpm --filter @workspace/ai-platform run build && pnpm --filter @workspace/customer-portal run build && pnpm run build:api && node ./scripts/hostinger-stage-frontend.cjs",
    "verify:openapi": "pnpm --filter @workspace/scripts run workspace-check",
    "verify:generated": "pnpm --filter @workspace/scripts run workspace-check",
    "verify:types": "pnpm run typecheck",
    "verify": "pnpm run verify:openapi && pnpm run verify:types",
    "clean:generated": "rm -rf lib/api-client-react/src/generated lib/api-zod/src/generated",
    "clean:workspace": "pnpm run clean:generated && rm -rf artifacts/api-server/dist artifacts/ai-platform/dist artifacts/mockup-sandbox/dist",
    "rebuild:all": "pnpm run clean:workspace && pnpm run build:workspace && pnpm run verify",
    "workspace-health": "pnpm --filter @workspace/scripts run workspace-health",
    "migrate:prod": "pnpm --filter @workspace/scripts run migrate:prod",
    "migrate:prod:dry-run": "pnpm --filter @workspace/scripts run migrate:prod:dry-run",
    "ci:verify": "pnpm run verify",
    "ci:build": "pnpm run build:workspace",
    "ci:test": "pnpm -r --if-present run test",
    "ci:codegen": "pnpm run build:generated",
    "security:scan-secrets": "pnpm --filter @workspace/scripts run security:scan-secrets",
    "zerollm:bootstrap": "node ./scripts/zerollm-bootstrap.cjs",
    "zerollm:verify": "node --check ./scripts/zerollm-bootstrap.cjs && node --check ./scripts/hostinger-start.cjs"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
