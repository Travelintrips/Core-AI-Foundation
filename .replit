modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

# ─── Non-secret environment configuration ────────────────────────────────────
# All secrets (API keys, passwords, tokens, JWTs, database credentials) are
# stored exclusively in Replit Secrets and are NOT present in this file.
# See .env.example for the full list of required secret variable names.
# ─────────────────────────────────────────────────────────────────────────────

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = "465"
SMTP_FROM = "info@cstlogistic.co.id"
SMTP_USER = "info@cstlogistic.co.id"
ALLOWED_ORIGINS = "https://aicore.cstlogistic.co.id,https://core-ai-foundation-1.replit.app"
DESIGN_AI_MULTI_AGENT_ENABLED = "true"

[userenv.development]
SUPABASE_URL_DEV = "https://xssrfshdrtdfupgqwfdw.supabase.co"
VITE_SUPABASE_URL_DEV = "https://xssrfshdrtdfupgqwfdw.supabase.co"
SUPABASE_STORAGE_BUCKET_DEV = "https://xssrfshdrtdfupgqwfdw.storage.supabase.co/storage/v1/s3"

[userenv.production]
SUPABASE_URL = "https://nzdweipzckfszczzqtuw.supabase.co"
SUPABASE_STORAGE_BUCKET = "https://nzdweipzckfszczzqtuw.storage.supabase.co/storage/v1/s3"
PUBLIC_APP_URL = "https://aicore.cstlogistic.co.id"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20404
externalPort = 3000

[[ports]]
localPort = 20785
externalPort = 3001

[[ports]]
localPort = 23434
externalPort = 80
