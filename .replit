modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

# Replit is DEVELOPMENT ONLY.
# Runtime secrets must be configured in Replit Secrets, never committed here.
# Production runs on Hostinger from GitHub main and uses Hostinger environment variables.
# Do not configure Replit deployment for production.

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 20404
externalPort = 3000

[[ports]]
localPort = 20785
externalPort = 3001

[[ports]]
localPort = 23434
externalPort = 80
