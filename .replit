modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

# Only non-secret configuration belongs in this tracked file.
# API keys, database passwords, service-role keys, admin credentials, and
# other credentials must be injected through Replit Secrets/environment.
[userenv.shared]
SMTP_HOST = "smtp.hostinger.com"
SMTP_USER = "info@cstlogistic.co.id"
SMTP_PORT = "465"
SMTP_FROM = "info@cstlogistic.co.id"
ALLOWED_ORIGINS = "https://aicore.cstlogistic.co.id,https://core-ai-foundation-1.replit.app"
DESIGN_AI_MULTI_AGENT_ENABLED = "true"

[userenv.development]
APP_ENV = "development"
NODE_ENV = "development"
SUPABASE_URL_DEV = "https://xssrfshdrtdfupgqwfdw.supabase.co"
VITE_SUPABASE_URL_DEV = "https://xssrfshdrtdfupgqwfdw.supabase.co"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20404
externalPort = 3000

[[ports]]
localPort = 20785
externalPort = 3001

[[ports]]
localPort = 23434
externalPort = 80
